# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — PLATAFORMA CTC INSTITUTO MASIRA - UDES
# Copie este archivo como .env y defina sus propios valores antes de desplegar
# =============================================================================

POSTGRES_USER=reemplazar_usuario_db
POSTGRES_PASSWORD=reemplazar_password_seguro_db
POSTGRES_DB=masira_ctc_db
POSTGRES_PORT=5432

DATABASE_URL=postgres://reemplazar_usuario_db:reemplazar_password_seguro_db@postgres:5432/masira_ctc_db

JWT_SECRET=reemplazar_con_clave_secreta_jwt_aleatoria_64_caracteres
SEED_DEFAULT_PASSWORD=reemplazar_con_password_inicial_semilla

# Configuración de Servidor SMTP
SMTP_HOST=smtp
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Comite Tecnico Cientifico MASIRA <no-reply.ctc@udes.edu.co>
SMTP_TLS=false
SMTP_WEB_PORT=8025
PUBLIC_APP_URL=http://localhost:4200

BACKEND_PORT=8080
FRONTEND_PORT=4200
RUST_LOG=info
